{
  "title": "E-Commerce Platform",
  "uid": "ecommerce",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Kafka Messages Produced / Consumed",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(kafka_messages_produced_total[1m])",
          "legendFormat": "produced {{topic}}"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(kafka_messages_consumed_total[1m])",
          "legendFormat": "consumed {{topic}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Payment Success vs Failure",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(payment_success_total[1m])",
          "legendFormat": "success/min"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(payment_failure_total[1m])",
          "legendFormat": "failure/min"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Payment Success Rate",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.6 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "analytics_payment_success_rate"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg Order Processing (ms)",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "analytics_avg_processing_ms"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Orders per Minute",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "analytics_orders_per_minute",
          "legendFormat": "orders/min"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Order Processing Duration (p50 / p95)",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.5, rate(order_processing_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(order_processing_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
